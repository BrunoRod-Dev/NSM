{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "web": {
      "projectType": "application",
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "index": "apps/web/src/index.html",
            "browser": "apps/web/src/main.ts",
            "tsConfig": "apps/web/tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "apps/web/public", "output": "/" }],
            "styles": ["apps/web/src/styles.css"],
            "budgets": [{ "type": "initial", "maximumWarning": "750kB", "maximumError": "1MB" }]
          },
          "configurations": {
            "production": { "outputHashing": "all", "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": { "inline": false } } },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "web:build:development", "proxyConfig": "apps/web/proxy.conf.json" }
        }
      }
    }
  }
}
