# Copy to .env. Local-only credentials; replace for any nonlocal installation.
DATABASE_URL=postgresql://nsm:nsm_local_only@127.0.0.1:54329/nsm
TEST_DATABASE_URL=postgresql://nsm:nsm_local_only@127.0.0.1:54329/nsm_test
HOST=127.0.0.1
PORT=4301
APP_ORIGIN=http://localhost:4200
NODE_ENV=development
SESSION_DAYS=7
# The game and BIOS are read from this folder, never copied into NSM.
CRASH_PROJECT_DIR=C:/Users/bruno/Desktop/crash bash project
CRASH_HOST_USERNAME=admin
# Optional STUN/TURN JSON; credentials stay out of Git.
# RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Optional SBI subchannel metadata matching your local disc edition
# CRASH_SBI_PATH=C:/path/to/game.sbi

# CTR Europe EDC (SCES-02105), matching CHD and SBI
# CTR_GAME_PATH=C:/games/ctr.chd
# CTR_SBI_PATH=C:/games/SCES_021.05.sbi
