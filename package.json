{
  "name": "nsm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env apps/server/src/main.ts",
    "dev:web": "ng serve --host 0.0.0.0",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file=.env apps/server/src/cli.ts migrate",
    "invite": "tsx --env-file=.env apps/server/src/cli.ts invite",
    "check": "tsc -p apps/server/tsconfig.json --noEmit",
    "build": "npm run check && ng build && tsc -p apps/server/tsconfig.json",
    "start": "node --env-file=.env dist/server/apps/server/src/main.js",
    "test": "tsx --env-file=.env --test --test-concurrency=1 apps/server/test/*.test.ts",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "test:game:real": "tsx --env-file=.env scripts/real-game-smoke.ts"
  },
  "dependencies": {
    "@angular/common": "~21.2.26",
    "@angular/compiler": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/forms": "~21.2.26",
    "@angular/platform-browser": "~21.2.26",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "argon2": "^0.44.0",
    "fastify": "^5.12.8",
    "pg": "^8.16.3",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.8.1",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@fastify/static": { "glob": "^14.0.3" },
    "glob": { "minimatch": "^11.0.4" }
  },
  "devDependencies": {
    "@angular/build": "~21.2.26",
    "@angular/cli": "~21.2.26",
    "@angular/compiler-cli": "~21.2.26",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
